# --- Meta app (developers.facebook.com) ---
META_APP_ID=
META_APP_SECRET=
# Leave blank: auto = <your site>/auth/callback
META_REDIRECT_URI=
GRAPH_API_VERSION=v25.0

# Public base URL so Instagram can download files you upload (e.g. your ngrok URL)
PUBLIC_BASE_URL=

# Optional: AI-written captions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

FLASK_SECRET=change-me-to-a-long-random-string
APP_TIMEZONE=Asia/Kolkata

# --- Hosting / Android app ---
HTTPS_ONLY=0                      # 1 on the hosted (https) server
ANDROID_PACKAGE=com.igreach.app
ANDROID_SHA256=0C:66:FA:19:0B:30:A4:83:A2:B1:61:1D:CB:86:3E:0A:3D:77:31:E4:C2:6B:88:FD:BB:BA:30:CC:96:40:56:8E
APK_URL=                          # https://github.com/<you>/<repo>/releases/latest/download/IGReach.apk
